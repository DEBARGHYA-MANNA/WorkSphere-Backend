NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/worksphere?replicaSet=rs0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
# Keep enabled for local development; set false in production and provision indexes separately.
MONGOOSE_AUTO_INDEX=true
CORS_ORIGIN=http://localhost:5173
# Set to the trusted reverse-proxy hop count only when deployed behind a proxy.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
COOKIE_SAME_SITE=lax
SHUTDOWN_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=120000
